@page "{id:int}"
@model HeavyEquipmentMonitoring.Pages.Equipment.DeleteModel

@{
    ViewData["Title"] = "Archive Equipment";
}

<div class="dashboard-panel equipment-form">

    <div class="panel-header">
        <h2>Archive Equipment #@Model.Equipment.EquipmentNumber</h2>
    </div>

    <div class="form-content">

        <p class="form-description">
            Remove this equipment from active fleet operations.
            Historical records will be preserved.
        </p>

        <div class="form-grid">

            <div class="form-group">
                <label>Equipment Number</label>
                <input class="form-control"
                       value="@Model.Equipment.EquipmentNumber"
                       readonly />
            </div>

            <div class="form-group">
                <label>Equipment Type</label>
                <input class="form-control"
                       value="@Model.Equipment.EquipmentType"
                       readonly />
            </div>

            <div class="form-group">
                <label>Equipment Model</label>
                <input class="form-control"
                       value="@Model.Equipment.EquipmentModel"
                       readonly />
            </div>

            <div class="form-group">
                <label>Total Engine Hours</label>
                <input class="form-control"
                       value="@Model.Equipment.TotalEngineHours.ToString("N1")"
                       readonly />
            </div>

            <div class="form-group">
                <label>Engine Status</label>
                <input class="form-control"
                       value="@Model.Equipment.EngineStatus"
                       readonly />
            </div>

        </div>

        <form method="post"
              asp-route-id="@Model.Equipment.EquipmentID">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <div class="archive-section">

                <div class="form-group">

                    <label asp-for="ArchiveStatus">
                        Archive Status
                    </label>

                    <select asp-for="ArchiveStatus"
                            class="form-select" required>

                        <option value="">Select Archive Status</option>

                        <option value="Sold">
                            Sold
                        </option>

                        @if (!Model.Equipment.IsOutOfService)
                        {
                            <option value="OutOfService">
                                Out of Service
                            </option>
                        }

                    </select>

                    <span asp-validation-for="ArchiveStatus"
                          class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label asp-for="ArchiveReason">
                        Reason for Archiving
                    </label>

                    <textarea asp-for="ArchiveReason"
                              class="form-control"
                              rows="4"
                              maxlength="500"
                              placeholder="Enter the reason for removing this equipment..."
                              required></textarea>

                    <span asp-validation-for="ArchiveReason"
                          class="text-danger"></span>

                </div>

                <div class="archive-warning">

                    <strong>Important:</strong>

                    <p>
                        Sold equipment is no longer company-owned
                        and cannot be restored through the normal workflow.
                    </p>

                    <p>
                        Out of Service equipment remains company-owned
                        and may be restored when operational.
                    </p>

                    <p>
                        Maintenance, inspection, engine hours,
                        and project records will be preserved.
                    </p>

                </div>

            </div>

            <div class="form-actions">

                <button type="submit" class="btn-danger-custom">
                    Archive Equipment
                </button>

                <a asp-page="./Index" class="btn-cancel">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
