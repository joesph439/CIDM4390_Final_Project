
@page
@model HeavyEquipmentMonitoring.Pages.Equipment.IndexModel

@{
    ViewData["Title"] = "Equipment Inventory";
}

<h1>Equipment Inventory</h1>

<p>View and monitor all equipment in the system.</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Equipment Number</th>
            <th>Equipment Type</th>
            <th>Equipment Model</th>
            <th>Total Engine Hours</th>
            <th>Engine Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var equipment in Model.EquipmentList)
        {
            <tr>
                <td>@equipment.EquipmentNumber</td>
                <td>@equipment.EquipmentType</td>
                <td>@equipment.EquipmentModel</td>
                <td>@equipment.TotalEngineHours</td>
                <td>@equipment.EngineStatus</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.EquipmentList.Any())
{
    <div class="alert alert-info">
        No equipment has been added to the inventory yet.
    </div>
}
