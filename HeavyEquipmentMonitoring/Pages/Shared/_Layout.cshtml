@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Heavy Equipment Monitoring</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HeavyEquipmentMonitoring.styles.css"
          asp-append-version="true" />
</head>

<body class="dashboard-body">

    <div class="dashboard-layout">

        <!-- SIDEBAR -->
        <aside class="dashboard-sidebar">

            <div class="sidebar-brand">
                 <img src="wwwroot/images/execavtor-logo.jpg"alt="Excavator"class="sidebar-logo" />
                <h2>Heavy Equipment<br />Monitoring</h2>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">

                <a asp-page="/Index" class="sidebar-link">
                    <span>▦</span> Dashboard</a>

                <a asp-page="/Equipment/Index" class="sidebar-link">
                    <span>🚜</span> Equipment</a>

                <a asp-page="/Projects/Index" class="sidebar-link">
                    <span>▤</span> Projects</a>

                <a asp-page="/Inspections/Index" class="sidebar-link">
                    <span>☑</span> Inspections</a>

                <a asp-page="/Maintenance/Index" class="sidebar-link">
                    <span>🔧</span> Maintenance</a>

                <a asp-page="/Alerts/Index" class="sidebar-link">
                    <span>🔔</span> Alerts</a>

                <a class="sidebar-link" asp-page="/Simulation/Index">
                    <span>⚙️</span><span>Simulation</span></a>

            </nav>

        </aside>

        <!-- MAIN CONTENT -->
        <div class="dashboard-content">

            <header class="dashboard-topbar">

                <div class="topbar-title">
                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="topbar-account">
                    <partial name="_LoginPartial" />
                </div>

            </header>

            <main role="main" class="dashboard-main">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
