
@page
@model HeavyEquipmentMonitoring.Pages.Projects.IndexModel

@{
    ViewData["Title"] = "Projects";
}

<div class="equipment-dashboard">

    <div class="page-description">
        <p>Manage construction projects, equipment assignments, crews, and project activity.</p>
    </div>

    <!-- PROJECT SUMMARY CARDS -->

    <div class="summary-grid">

        <div class="summary-card total-card">
            <div class="summary-label">Total Projects</div>
            <div class="summary-value">@Model.TotalProjects</div>
        </div>

        <div class="summary-card maintenance-card">
            <div class="summary-label">Upcoming Projects</div>
            <div class="summary-value">@Model.UpcomingProjects</div>
        </div>

        <div class="summary-card running-card">
            <div class="summary-label">Active Projects</div>
            <div class="summary-value">@Model.ActiveProjects</div>
        </div>

        <div class="summary-card off-card">
            <div class="summary-label">Completed Projects</div>
            <div class="summary-value">@Model.CompletedProjects</div>
        </div>

        <div class="summary-card total-card">
            <div class="summary-label">Assigned Equipment</div>
            <div class="summary-value">@Model.AssignedEquipment</div>
        </div>

    </div>

    <!-- PROJECT SEARCH -->

    <section class="dashboard-panel equipment-search-panel">

        <div class="panel-header">
            <h2>Search Projects</h2>
        </div>

        <form method="get" class="equipment-search-form">

            <div class="project-search-grid">

                <div class="form-group">

                    <label asp-for="SearchString">
                        Project Name
                    </label>

                    <input asp-for="SearchString"
                           class="form-control"
                           placeholder="Search project name..." />

                </div>

                <div class="form-group">

                    <label asp-for="StatusFilter">
                        Project Status
                    </label>

                    <select asp-for="StatusFilter"
                            class="form-select">

                        <option value="All">All Statuses</option>
                        <option value="Upcoming">Upcoming</option>
                        <option value="Active">Active</option>
                        <option value="Completed">Completed</option>

                    </select>

                </div>

            </div>

            <div class="search-actions">

                <button type="submit" class="btn-gold">
                    Search
                </button>

                <a asp-page="./Index" class="btn-cancel">
                    Clear Filters
                </a>

            </div>

        </form>

    </section>

    <!-- PROJECT INVENTORY -->

    <section class="dashboard-panel">

        <div class="panel-header">

            <h2>Project Inventory</h2>

            <div class="panel-actions">

                <a asp-page="./Create" class="btn-gold">
                    Create Project
                </a>

            </div>

        </div>

        <div class="search-result-info">
            Showing @Model.MatchingProjects of @Model.TotalProjects projects
        </div>

        <div class="table-responsive">

            <table class="table equipment-table">

                <thead>
                    <tr>
                        <th>Project ID</th>
                        <th>Project Name</th>
                        <th>Project Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Assigned Equipment</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var project in Model.ProjectList)
                    {
                        var equipmentCount = Model.ProjectEquipmentCounts.GetValueOrDefault(project.ProjectID, 0);
                        <tr>

                            <td>@project.ProjectID</td>

                            <td>@project.ProjectName</td>

                            <td>
                                <span class="equipment-status status-@(project.ProjectStatus.ToLowerInvariant())">
                                    @project.ProjectStatus
                                </span>
                            </td>

                            <td>
                                @project.StartDate.ToString("MM/dd/yyyy")
                            </td>

                            <td>
                                @(project.EndDate?.ToString("MM/dd/yyyy") ?? "—")
                            </td>

                            <td>@equipmentCount</td>

                            <td>

                                <div class="equipment-actions">

                                    <a asp-page="./Details"
                                       asp-route-id="@project.ProjectID"
                                       class="btn-details">
                                        Details
                                    </a>

                                    @if (project.ProjectStatus != "Completed")
                                    {
                                        <a asp-page="./Edit"
                                           asp-route-id="@project.ProjectID"
                                           class="btn-edit">
                                            Edit
                                        </a>
                                    }

                                    @if (project.ProjectStatus == "Active")
                                    {
                                        <a asp-page="./Complete"
                                           asp-route-id="@project.ProjectID"
                                           class="btn-complete">
                                            Complete
                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                    @if (!Model.ProjectList.Any())
                    {
                        <tr>
                            <td colspan="7" class="empty-table">

                                @if (Model.TotalProjects == 0)
                                {
                                    <span>No projects have been created yet.</span>
                                }
                                else
                                {
                                    <span>No projects match your search criteria.</span>
                                }

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>

</div>
