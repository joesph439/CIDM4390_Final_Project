@page "{id:int}"
@model HeavyEquipmentMonitoring.Pages.Projects.EditModel

@{
    ViewData["Title"] = "Edit Project";
}

<div class="equipment-dashboard">

    <section class="dashboard-panel equipment-form">

        <div class="panel-header">

            <h2>Project Information</h2>

            <span class="equipment-status status-@(Model.CurrentStatus.ToLowerInvariant())">
                @Model.CurrentStatus
            </span>

        </div>

        <div class="form-content">

            <p class="form-description">
                Update the existing construction project information below.
            </p>

            <form method="post" asp-route-id="@Model.ProjectID">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="form-grid">

                    <!-- PROJECT ID -->

                    <div class="form-group">

                        <label>Project ID</label>

                        <input type="text"
                               class="form-control"
                               value="@Model.ProjectID"
                               readonly />

                    </div>

                    <!-- PROJECT NAME -->

                    <div class="form-group">

                        <label asp-for="Input.ProjectName">
                            Project Name *
                        </label>

                        <input asp-for="Input.ProjectName"
                               class="form-control"
                               maxlength="150"
                               required />

                        <span asp-validation-for="Input.ProjectName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- PROJECT STATUS -->

                    <div class="form-group">

                        <label asp-for="Input.ProjectStatus">
                            Project Status *
                        </label>

                        <select asp-for="Input.ProjectStatus"
                                class="form-select"
                                required>

                            @if (Model.CurrentStatus == "Upcoming")
                            {
                                <option value="Upcoming">
                                    Upcoming
                                </option>
                            }

                            <option value="Active">
                                Active
                            </option>

                        </select>

                        <span asp-validation-for="Input.ProjectStatus"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- START DATE -->

                    <div class="form-group">

                        <label asp-for="Input.StartDate">
                            Start Date *
                        </label>

                        <input asp-for="Input.StartDate"
                               type="date"
                               class="form-control"
                               required />

                        <span asp-validation-for="Input.StartDate"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- END DATE -->

                    <div class="form-group">

                        <label>End Date</label>

                        <input type="text"
                               class="form-control"
                               value="Set when project is completed"
                               readonly />

                    </div>

                </div>

                <!-- PROJECT HISTORY NOTICE -->

                <div class="project-notice">

                    <strong>Project History</strong>

                    <p>
                        Updating project information will not remove
                        existing equipment, crew, or employee assignments.
                    </p>

                </div>

                <!-- FORM ACTIONS -->

                <div class="form-actions">

                    <button type="submit" class="btn-gold">
                        Save Changes
                    </button>

                    <a asp-page="./Index" class="btn-cancel">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
